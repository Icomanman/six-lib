{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Manim: Canvas",
      "type": "debugpy",
      "request": "launch",
      "module": "manim",
      "args": [
        "render",
        "-pqh",
        "--fps",
        "25",
        "-s",
        "${workspaceFolder}/src/sixlib/canvas.py",
        "Canvas"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src/sixlib"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "helpers",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/sixlib/helpers/getters.py",
      "console": "integratedTerminal"
    }
  ]
}